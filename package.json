{
  "name": "run-eu-local-tracker",
  "private": true,
  "version": "2.0.0",
  "description": "Local YAML-backed RUN-EU application tracker with editable dashboard",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "start": "node dist-server/index.js",
    "build:css": "tailwindcss -i ./src/input.css -o ./public/styles.css --minify",
    "build:client": "vite build --config vite.config.ts",
    "test": "tsx --test src/client/revisions.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "yarn typecheck && yarn build:css && yarn build:client && tsc -p tsconfig.server.json"
  },
  "dependencies": { "yaml": "^2.8.1" },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@tailwindcss/cli": "^4.1.14",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "tailwindcss": "^4.1.14"
  }
}
