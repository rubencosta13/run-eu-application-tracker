{
  "name": "run-eu-local-tracker",
  "private": true,
  "version": "2.0.0",
  "description": "Local YAML-backed RUN-EU application tracker with editable dashboard",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "node --watch server.mjs",
    "start": "node server.mjs",
    "build:css": "tailwindcss -i ./src/input.css -o ./public/styles.css --minify",
    "build": "yarn build:css"
  },
  "dependencies": { "yaml": "^2.8.1" },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.14",
    "tailwindcss": "^4.1.14"
  }
}
